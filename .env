# Конфигурация сервиса сокращения ссылок.
# Значения можно переопределить одноимёнными переменными окружения.

# Время жизни ссылки в минутах (задаётся системой, по умолчанию 1440 = сутки)
LINK_TTL_MINUTES=1440

# Базовый адрес коротких ссылок
BASE_URL=clck.ru

# Лимит переходов по умолчанию, если пользователь не задал свой
DEFAULT_MAX_CLICKS=100
